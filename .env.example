# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Postgres connection string for the workspace database (Supabase → Connect → Transaction pooler).
DATABASE_URL=

# Claude API key from console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Comma-separated emails allowed to create workspace accounts.
TEAM_ALLOWED_EMAILS=

# A long random code (12+ characters) needed to create an account on /setup.
TEAM_SETUP_CODE=

# Optional: override the Claude model or effort.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
